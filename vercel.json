{
  "rewrites": [
    { "source": "/proxy/anthropic", "destination": "/api/proxy-anthropic" },
    { "source": "/proxy/elevenlabs", "destination": "/api/proxy-elevenlabs" }
  ],
  "headers": [
    { "source": "/(audio|fonts|media)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(goal.mp3|stadium.jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" }
    ] }
  ]
}
